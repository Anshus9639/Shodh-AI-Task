            },
            {
              "$ref": "#/$defs/Missing"
            },
            {
              "$ref": "#/$defs/And"
            },
            {
              "$ref": "#/$defs/Or"
            },
            {
              "$ref": "#/$defs/NotNode"
            },
            {
              "$ref": "#/$defs/NotTrue"
            },
            {
              "$ref": "#/$defs/Const"
            }
          ],
          "title": "Item"
        },
        "kind": {
          "const": "not_true",
          "default": "not_true",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "item"
      ],
      "title": "NotTrue",
      "type": "object"
    },
