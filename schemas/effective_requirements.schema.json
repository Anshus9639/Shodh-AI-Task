        "UNAPPROVED_CHANGE",
        "REJECTED_CHANGE",
        "APPROVAL_IGNORED",
        "UNSUPPORTED_CHANGE_OPERATION",
        "UNTRUSTED_APPROVAL_CLAIM",
        "SUSPECTED_INJECTION",
        "UNSUPPORTED_LANGUAGE",
        "UNSUPPORTED_CODE",
        "AMBIGUITY",
