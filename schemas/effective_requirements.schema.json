          "discriminator": {
            "mapping": {
              "and": "#/$defs/And",
              "cmp": "#/$defs/Cmp",
              "const": "#/$defs/Const",
              "eq": "#/$defs/Eq",
              "in": "#/$defs/In",
              "missing": "#/$defs/Missing",
              "ne": "#/$defs/Ne",
              "not": "#/$defs/NotNode",
              "not_in": "#/$defs/NotIn",
              "not_true": "#/$defs/NotTrue",
              "or": "#/$defs/Or"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/Cmp"
            },
            {
              "$ref": "#/$defs/Eq"
            },
            {
              "$ref": "#/$defs/Ne"
            },
            {
              "$ref": "#/$defs/In"
            },
            {
