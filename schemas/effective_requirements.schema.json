{
  "$defs": {
    "AnchorType": {
      "enum": [
        "source_line",
        "line_range",
        "json_pointer",
        "paragraph",
        "named_block"
      ],
      "title": "AnchorType",
      "type": "string"
    },
    "And": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "discriminator": {
              "mapping": {
                "and": "#/$defs/And",
                "cmp": "#/$defs/Cmp",
                "const": "#/$defs/Const",
                "eq": "#/$defs/Eq",
                "in": "#/$defs/In",
                "missing": "#/$defs/Missing",
                "ne": "#/$defs/Ne",
                "not": "#/$defs/NotNode",
                "not_in": "#/$defs/NotIn",
                "not_true": "#/$defs/NotTrue",
                "or": "#/$defs/Or"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/Cmp"
              },
              {
                "$ref": "#/$defs/Eq"
              },
              {
                "$ref": "#/$defs/Ne"
              },
              {
                "$ref": "#/$defs/In"
              },
              {
                "$ref": "#/$defs/NotIn"
              },
              {
                "$ref": "#/$defs/Missing"
              },
              {
                "$ref": "#/$defs/And"
              },
              {
                "$ref": "#/$defs/Or"
              },
              {
                "$ref": "#/$defs/NotNode"
              },
              {
                "$ref": "#/$defs/NotTrue"
              },
              {
                "$ref": "#/$defs/Const"
              }
            ]
          },
          "minItems": 2,
          "title": "Items",
          "type": "array"
        },
        "kind": {
          "const": "and",
          "default": "and",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "items"
      ],
      "title": "And",
      "type": "object"
    },
    "ChangeDecision": {
      "additionalProperties": false,
      "properties": {
        "approval_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Approval Ids",
          "type": "array"
        },
        "change_id": {
          "title": "Change Id",
          "type": "string"
        },
        "change_version": {
          "title": "Change Version",
          "type": "string"
        },
        "content_hash": {
          "title": "Content Hash",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/ChangeState"
        }
      },
      "required": [
        "change_id",
        "change_version",
        "state",
        "reason",
        "content_hash"
      ],
