    "prompt_version": {
      "title": "Prompt Version",
      "type": "string"
    },
    "rules": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RuleSummary"
      },
      "title": "Rules",
      "type": "array"
    },
    "unreviewed": {
      "default": [],
      "items": {
        "$ref": "#/$defs/UnreviewedSummary"
      },
      "title": "Unreviewed",
      "type": "array"
