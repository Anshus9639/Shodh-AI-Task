{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "version"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "TextSpan": {
      "additionalProperties": false,
      "properties": {
        "col_end": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Col End"
        },
        "col_start": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Col Start"
        },
        "excerpt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Excerpt"
        },
        "kind": {
          "const": "text",
          "default": "text",
          "title": "Kind",
          "type": "string"
        },
        "line_end": {
          "minimum": 1,
          "title": "Line End",
          "type": "integer"
        },
        "line_start": {
          "minimum": 1,
          "title": "Line Start",
          "type": "integer"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path",
        "line_start",
        "line_end"
      ],
      "title": "TextSpan",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One requirement statement tied to an exact span of its source artifact.\n\nThe anchor is evidence, not a claim: ``source_ref`` identifies the declared\nartifact version and ``anchor`` must resolve against that artifact's text.",
  "properties": {
    "anchor": {
      "$ref": "#/$defs/TextSpan"
    },
    "destination": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Destination"
    },
    "requirement_id": {
      "minLength": 1,
      "title": "Requirement Id",
      "type": "string"
    },
    "source_ref": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "source_text": {
      "minLength": 1,
      "title": "Source Text",
      "type": "string"
    }
  },
  "required": [
    "requirement_id",
    "source_ref",
    "anchor",
    "source_text"
  ],
  "title": "AnchoredRequirement",
  "type": "object"
}
